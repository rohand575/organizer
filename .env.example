# Firebase web app config — copy this file to `.env` and fill in real values
# from Firebase Console → Project Settings → Your apps → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Voice assistant (optional). Add at least one key to enable the mic button.
# Groq is used first (fast, free tier), OpenAI as fallback. Set a spend cap on
# these keys — they ship in the client bundle of this static app.
# Groq: https://console.groq.com/keys   OpenAI: https://platform.openai.com/api-keys
VITE_GROQ_API_KEY=
VITE_OPENAI_API_KEY=

# Google Calendar (optional). OAuth Web client ID from Google Cloud Console →
# APIs & Services → Credentials. Enable the Google Calendar API, and add your
# app origins (e.g. http://localhost:5173 and your hosted domain) to the
# client's "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
